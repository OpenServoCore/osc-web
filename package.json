{
  "name": "osc-web",
  "private": true,
  "version": "0.0.0",
  "description": "Web GUI for OpenServoCore servos over WebUSB",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "wasm": "cd ../open-servo-core/client/web && wasm-pack build --target web --out-dir pkg"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-start": "1.168.57",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@types/babel__core": "7.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/w3c-web-usb": "1.0.14",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
